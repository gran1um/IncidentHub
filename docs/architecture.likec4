  incidenthub.backend.attachment_repo -> incidenthub.postgres.pg_workspace "case_attachments table operations"
  incidenthub.backend.catalog_repo -> incidenthub.postgres "catalog_items"
  incidenthub.backend.catalog_repo -> incidenthub.postgres.pg_catalog "catalog_items and status config operations"
