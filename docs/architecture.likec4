specification {
  element person
  element softwareSystem
  element container
  element component
}

model {
  platform_admin = person "Platform Administrator" "Global governance, platform policies, tenants and cross-tenant security controls"
  tenant_admin = person "Tenant Administrator" "Tenant-level configuration, users, statuses, connectors and automation"
  soc_analyst = person "SOC Analyst" "Triage alerts, investigate cases, run response actions and collaborate in threads"
  incident_commander = person "Incident Commander" "Oversees major incidents, timelines and coordination status"
  viewer = person "Viewer" "Read-only visibility to tenant KPIs and incident context"
  automation_bot = person "Automation Bot" "CI/CD and playbooks calling API endpoints with admin-issued API tokens"

  external_security_sources = softwareSystem "External Security Sources" "SIEM, EDR, IDS, email gateways, cloud security feeds"
  external_data_sources = softwareSystem "External Data Services" "SQL DBs, object stores, REST feeds, Kafka topics"
  external_comm_channels = softwareSystem "External Communication Channels" "Telegram, webhook receivers, email-like gateways"
  identity_provider = softwareSystem "Identity Provider / LDAP" "Central user identity and password policy authority"
  threat_intel = softwareSystem "Threat Intelligence Feeds" "IOC and reputation context feeds consumed by connectors"
  ticketing_system = softwareSystem "Ticketing / ITSM" "Optional downstream notifications and escalation tracking"

  incidenthub = softwareSystem "IncidentHub Platform" {
    frontend = container "Frontend SPA" "React + TypeScript + Vite" "SOC workbench and administration console" {
      app_shell = component "App Shell + Routing" "Global layout, route guards, session bootstrap, tenant context selection"
      auth_ui = component "Auth + Session UI" "Login, logout, session state and token refresh handling"
      dashboard_ui = component "Dashboard UI" "KPI cards, trends, operational health and tenant overview"
      alerts_ui = component "Alerts UI" "List, filter, triage, bulk actions and case linking"
      cases_ui = component "Cases UI" "Case listing, creation, ownership and bulk lifecycle actions"
      case_workspace_ui = component "Case Workspace UI" "Case details, observables, tasks, timeline, pages and attachments"
      comms_ui = component "Case Communications UI" "External participant threads and message sync in case context"
      forum_ui = component "Forum UI" "Threaded analyst collaboration with attachments and proxy relay"
      catalog_ui = component "Catalog + Templates UI" "Catalog entities, statuses, methods and response templates"
      connectors_ui = component "Connectors UI" "Inbound/outbound connector configuration and manual run controls"
      ai_ui = component "AI Assistant UI" "Q&A, case analysis prompts, verdict and recommendations rendering"
      admin_ui = component "Administration UI" "Tenant/user admin, API tokens, XP settings, platform-level controls"
      profile_ui = component "Profile + Experience UI" "User profile, levels, XP bar, performance and history panels"
      workflow_studio_ui = component "Workflow Studio UI" "Top-level workflow page, list/detail modes, save/run/test actions"
      workflow_list_ui = component "Workflow List + Filters UI" "Pagination, search and type filters for analyzer/responder workflows"
      workflow_canvas_ui = component "Workflow Canvas UI" "Graph board with nodes, edges, drag/drop and entry-node control"
      workflow_library_ui = component "Workflow Block Library UI" "Dynamic block catalog loaded from folder-based node manifests"
      workflow_inspector_ui = component "Workflow Inspector UI" "Node config editor and edge conditions panel"
      workflow_runs_ui = component "Workflow Runs History UI" "Latest run status, duration, errors and retention indicator"
      api_client = component "Typed API Client + React Query" "HTTP calls, cache invalidation, optimistic updates and retries"
      i18n_theme = component "I18n + Theme Layer" "Localization dictionaries, theme toggles and UX presentation rules"
    }

    backend = container "Backend API" "Go + Echo v5" "Auth, RBAC, tenant isolation, SOC domain APIs, connectors and AI orchestration" {
      router = component "HTTP Router + Endpoint Registry" "Route graph for /api/v1, health, metrics and dev swagger"
      security_headers = component "Security Headers Middleware" "CSP, frame, content-type and referrer protections"
      request_metrics = component "Request Metrics Middleware" "Per-route timing, status cardinality and Prometheus counters"
      error_handler = component "HTTP Error Handler" "Consistent API error mapping and response serialization"

      auth_mw = component "JWT / API Token Auth Middleware" "Parses bearer token, resolves identity (jwt or api_token)"
      api_token_policy = component "API Token Access Policy Middleware" "Blocks user-account routes and enforces resource scopes"
      api_scope_engine = component "API Token Scope Engine" "Maps route->resource/action and evaluates token scopes"
      tenant_resolver = component "Tenant Resolver Middleware" "Resolves X-Tenant-ID and membership for tenant context"
      rbac_policy = component "RBAC Middleware" "Tenant role checks and platform admin guards per endpoint"
      login_rate_limiter = component "Login Rate Limiter" "Redis-backed brute-force protection for auth endpoints"
      api_cache_read = component "API Cache Read Middleware" "Cached responses for eligible GET routes"
      api_cache_invalidate = component "API Cache Invalidation Middleware" "Version-based invalidation on mutations"
      audit_pipeline = component "Audit Pipeline" "Structured security-relevant audit entries per action"

      auth_api = component "Auth API" "Login, refresh, logout, /me and session lifecycle operations"
      session_manager = component "Session Manager" "Session cookie rotation and refresh token lifecycle orchestration"
      users_api = component "Users API" "User CRUD/profile/password/media and tenant-user listing"
      tenants_api = component "Tenants API" "Tenant creation/update/listing and governance attributes"
      api_tokens_api = component "Admin API Tokens API" "Issue/list/revoke tenant-scoped API access tokens"
      alerts_api = component "Alerts API" "Alert CRUD and bulk bind/create-case operations"
      cases_api = component "Cases API" "Case CRUD, status resolution and closure rewards"
      case_status_engine = component "Case Status Engine" "Validates tenant status model and open/closed semantics"
      case_bulk_engine = component "Case Bulk Engine" "Bulk bind/import from alerts and batch mutation helpers"
      case_workspace_api = component "Case Workspace API" "Tasks, observables, case events, pages and attachments metadata"
      attachments_api = component "Media + Attachment Upload API" "Presigned upload/download and metadata persistence"
      forum_api = component "Forum API" "Thread/post creation and forum attachment posting"
      comms_api = component "Case Communications API" "Thread creation, message send, sync and transcript retrieval"
      catalog_api = component "Catalog API" "Templates, statuses, achievements, methods and automation config"
      connectors_api = component "Connectors API" "Inbound/outbound connector read/config and manual run triggers"
      workflow_api = component "Workflow Runtime API" "Run/test-run/list-runs endpoints for workflow definitions"
      ai_api = component "AI API" "Chat session/messages and case analysis endpoints"
      search_api = component "Search API" "Cross-entity search over alerts, cases and threads"
      experience_api = component "Experience API" "XP events, manual grants, user performance and progress stats"
      notifications_api = component "Notification Settings API" "Tenant bot CRUD and per-user delivery preferences"
      system_api = component "System API" "Health, resources, tenant runtime and diagnostics endpoints"

      async_ops_queue = component "Async Ops Queue (Kafka)" "Queue + consumer loop for async create/delete alerts/cases"
      notification_delivery_queue = component "Notification Delivery Queue (Kafka)" "Catalog notification enqueue + Kafka consumer with retry/DLQ delivery"
      inbound_worker = component "Inbound Connector Worker" "Scheduled/manual ingestion from HTTP/SQL/S3/Kafka/Redis"
      ingestion_scheduler = component "Ingestion Scheduler" "Cron-based trigger planning for inbound connector jobs"
      source_http_adapter = component "Inbound HTTP Adapter" "Fetch and parse HTTP connector payloads"
      source_sql_adapter = component "Inbound SQL Adapter" "Query SQL sources and normalize rows"
      source_s3_adapter = component "Inbound S3 Adapter" "Read object batches from buckets"
      source_kafka_adapter = component "Inbound Kafka Adapter" "Consume configured topic partitions"
      source_redis_adapter = component "Inbound Redis Adapter" "Pop list batches and normalize messages"
      outbound_service = component "Outbound Connector Service" "Driver abstraction for mock/webhook/telegram/kafka/redis"
      outbound_driver_mock = component "Outbound Driver: Mock" "Deterministic send/poll for local testing"
      outbound_driver_webhook = component "Outbound Driver: Webhook" "HTTP send and poll endpoint integration"
      outbound_driver_telegram = component "Outbound Driver: Telegram" "Telegram Bot API send/getUpdates integration"
      outbound_driver_kafka = component "Outbound Driver: Kafka" "Kafka producer and consumer poll bridge"
      outbound_driver_redis = component "Outbound Driver: Redis" "Redis list send/poll transport bridge"
      forum_proxy = component "Forum Proxy Service" "External conversation binding, send/sync state machine"
      forum_sync_engine = component "Forum Sync Engine" "Cursor-based sync for external thread state"
      workflow_runtime = component "Workflow Runtime Engine" "Definition traversal engine with node executor dispatch"
      workflow_definition_engine = component "Workflow Definition Normalizer" "Parses/normalizes graph JSON (nodes/edges/entryNodeId)"
      workflow_node_registry = component "Workflow Node Registry" "Built-in node executor registration and dispatch map"
      workflow_node_trigger = component "Workflow Node: Trigger" "Start node, event marker propagation"
      workflow_node_webhook_trigger = component "Workflow Node: Webhook Trigger" "Poll outbound webhook connector for new messages"
      workflow_node_kafka_trigger = component "Workflow Node: Kafka Trigger" "Poll outbound kafka connector for new messages"
      workflow_node_condition = component "Workflow Node: Condition" "Boolean expression branch selection"
      workflow_node_switch = component "Workflow Node: Switch" "Multi-branch value matching with default route"
      workflow_node_delay = component "Workflow Node: Delay" "Wait for configured seconds before continuing"
      workflow_node_scheduler = component "Workflow Node: Scheduler" "Delay/until-time scheduling with max wait cap"
      workflow_node_transform = component "Workflow Node: Transform" "Template/JSON payload remapping"
      workflow_node_aggregate = component "Workflow Node: Aggregate" "Array aggregation (count/sum/avg/min/max/concat/unique)"
      workflow_node_analyzer = component "Workflow Node: Analyzer Action" "Connector action execution for analyzer workflows"
      workflow_node_responder = component "Workflow Node: Responder Action" "Connector action execution for responder workflows"
      workflow_node_redis = component "Workflow Node: Redis" "Direct Redis key/list operations"
      workflow_node_postgres = component "Workflow Node: Postgres Query" "Read-only SQL query execution"
      workflow_node_cassandra = component "Workflow Node: Cassandra Query" "HTTP Cassandra gateway query execution"
      workflow_node_telegram = component "Workflow Node: Telegram Send" "Direct telegram message send via outbound connector"
      workflow_node_python = component "Workflow Node: Python Code" "Sandboxed python3 execution with input/payload scope"
      workflow_node_s3 = component "Workflow Node: S3 Object" "Put/get/presign object operations"
      ai_service = component "AI Service" "Retrieval + prompt assembly + model execution + persistence"
      ai_retriever = component "AI Retrieval Engine" "Tenant-aware retrieval against search corpus"
      ai_prompt_builder = component "AI Prompt Builder" "Prompt context assembly and truncation strategy"
      ai_response_parser = component "AI Response Parser" "Normalizes structured analysis payloads"
      search_fallback_engine = component "Search Fallback Engine" "Fallback DB list+filter path when search index misses"
      xp_service = component "Experience Reward Service" "XP awarding logic for achievements, closures and manual grants"
      media_service = component "Artifact Storage Service" "S3 abstraction for user media and case attachments"
      migration_runner = component "Migration Runner" "Applies SQL migrations with advisory lock and schema tracking"
      bootstrap_seed = component "Bootstrap Seed Service" "Creates platform admin and starter entities"

      user_repo = component "User Repository" "users and profile-related storage operations"
      tenant_repo = component "Tenant Repository" "tenants persistence and platform-level tenant operations"
      membership_repo = component "Membership Repository" "tenant memberships and role membership checks"
      refresh_repo = component "Refresh Token Repository" "refresh token create/revoke/list/session checks"
      api_token_repo = component "API Access Token Repository" "api_access_tokens create/list/revoke/lookup"
      alert_repo = component "Alert Repository" "alerts CRUD and bulk bind to case"
      case_repo = component "Case Repository" "cases CRUD and case creation with linked alerts"
      task_repo = component "Task Repository" "case tasks lifecycle persistence"
      observable_repo = component "Observable Repository" "observables CRUD and verdict/source metadata"
      case_event_repo = component "Case Event Repository" "case event timeline entries"
      case_page_repo = component "Case Page Repository" "long-form case pages and notes"
      attachment_repo = component "Attachment Repository" "case attachment metadata and lookup"
      catalog_repo = component "Catalog Repository" "catalog_items generalized storage"
      connector_repo = component "Connector State Repository" "connector ingest states and run history"
      workflow_run_repo = component "Workflow Run Repository" "workflow_runs create/finish/list/retention operations"
      notification_bot_repo = component "Notification Bot Repository" "telegram_notification_bots CRUD and tenant lookups"
      notification_settings_repo = component "Notification Settings Repository" "user_notification_settings get/upsert/delete"
      forum_binding_repo = component "Forum Binding Repository" "forum_external_bindings and recipient aliases"
      ai_repo = component "AI Repository" "ai_chat_sessions, ai_chat_messages, case_ai_analyses"
      experience_repo = component "Experience Repository" "user_experience_events and related aggregates"
      audit_repo = component "Audit Repository" "append-only audit event persistence"
      system_repo = component "System Repository" "tenant/system stats and operational counters"
    }

    frontend_runtime_packages = container "Frontend Runtime Packages" "TypeScript/React source layout" "Package-level map of runtime-significant frontend folders used by the SPA" {
      fe_src_pages = component "frontend/src/pages - Route screens and workspace pages" "Top-level screens, page composition and route-focused UX"
      fe_src_components = component "frontend/src/components - Reusable UI and layout primitives" "Shared visual building blocks, layout shells and cross-page widgets"
      fe_src_lib_api = component "frontend/src/lib/api - Typed API hooks and HTTP integration" "React Query hooks, fetch orchestration and backend contract adapters"
      fe_src_lib_shared = component "frontend/src/lib - Shared runtime state, i18n, theme and utilities" "Cross-cutting client runtime helpers, stores and presentation utilities"
      fe_features_workflow_studio = component "frontend/src/features/workflow-studio - Workflow editor feature modules" "Canvas runtime, block registry and workflow-specific editor behavior"
      fe_features_connectors = component "frontend/src/features/connectors - Connector feature modules" "Connector-specific interaction flows and supporting UX helpers"
      fe_src_hooks = component "frontend/src/hooks - Shared hooks and interaction state" "Reusable hooks for time, toast, loading, mobile and local UI behavior"
    }

    backend_runtime_packages = container "Backend Runtime Packages" "Go source layout" "Package-level map of runtime-significant backend packages used by API, workers and services" {
      be_cmd_api = component "backend/cmd/api - Process bootstrap and dependency wiring" "Application entrypoint, dependency assembly and background worker startup"
      be_internal_config = component "backend/internal/config - Environment configuration and settings" "Runtime config parsing, defaults and application settings contracts"
      be_internal_database = component "backend/internal/database - DB init and migration lifecycle" "Postgres pool setup, migration execution and database runtime helpers"
      be_internal_bootstrap = component "backend/internal/bootstrap - Startup bootstrap and seed flows" "Initial platform admin creation and runtime bootstrap orchestration"
      be_internal_api = component "backend/internal/api - HTTP handlers and transport contracts" "Route handlers, request/response models and operational endpoint orchestration"
      be_internal_middleware = component "backend/internal/middleware - Auth, tenant, RBAC and cache middleware" "Request pipeline for auth, access control, tenancy, cache and security policies"
      be_internal_auth = component "backend/internal/auth - JWT and LDAP authentication services" "Token issuance/validation and LDAP-backed identity verification"
      be_internal_repository = component "backend/internal/repository - Persistence layer and data access" "Tenant-scoped repositories for domain entities, sessions, audits and runtime state"
      be_internal_cache = component "backend/internal/cache - Redis cache and rate-limit adapters" "Distributed cache access, version counters and login throttling primitives"
      be_connectors_inbound = component "backend/internal/connectors/inbound - Ingestion workers and source adapters" "Inbound connectors, scheduled/manual workers and source-specific ingestion paths"
      be_connectors_outbound = component "backend/internal/connectors/outbound - Delivery drivers and transport service" "Outbound send/poll drivers and connector delivery orchestration"
      be_internal_forumproxy = component "backend/internal/forumproxy - External thread proxy and sync" "Conversation proxy state machine, bindings and synchronization logic"
      be_internal_workflow = component "backend/internal/workflow - Workflow runtime and node execution" "Definition normalization, node dispatch and runtime execution engine"
      be_internal_ai = component "backend/internal/ai - AI orchestration and retrieval services" "Prompt assembly, retrieval, inference orchestration and response normalization"
      be_internal_search = component "backend/internal/search - Search integration services" "Elasticsearch integration and search-related adapters"
      be_internal_storage = component "backend/internal/storage - Artifact storage abstraction" "S3/MinIO storage adapters for media and binary artifacts"
      be_internal_metrics = component "backend/internal/metrics - Prometheus metrics and counters" "Operational metrics collection, counters, gauges and scrape surface"
      be_internal_tracing = component "backend/internal/tracing - OpenTelemetry tracing integration" "Trace initialization, span helpers and telemetry export wiring"
    }

    postgres = container "PostgreSQL" "PostgreSQL 18 (17/18 compatible)" "Primary source of truth for domain entities and auth/session state" {
      pg_auth = component "Auth Tables" "users, refresh_tokens, api_access_tokens"
      pg_tenant = component "Tenant Tables" "tenants, tenant_memberships"
      pg_incidents = component "Incident Core Tables" "alerts, cases, tasks, observables"
      pg_workspace = component "Workspace Tables" "case_events, case_pages, case_attachments"
      pg_catalog = component "Catalog Tables" "catalog_items, case_statuses"
      pg_connectors = component "Connector Tables" "connector_ingest_state, inbound_connector_runs, forum bindings"
      pg_workflows = component "Workflow Tables" "workflow_runs and workflow graph definitions stored in catalog_items"
      pg_notifications = component "Notification Tables" "telegram_notification_bots and user_notification_settings"
      pg_ai = component "AI Tables" "ai_chat_sessions, ai_chat_messages, case_ai_analyses"
      pg_experience = component "Experience Tables" "user_experience_events, user_achievements, reward config"
      pg_audit = component "Audit Tables" "audit_logs"
      pg_migrations = component "Schema Tables" "schema_migrations and bootstrap markers"
    }

    redis = container "Redis" "Redis 7" "Rate limits, API cache entries and cache version counters" {
      redis_rate_limit = component "Rate Limit Keys" "Per-IP/login rolling windows"
      redis_api_cache = component "API Cache Entries" "Serialized response payload cache"
      redis_cache_versions = component "Cache Version Keys" "Versioned invalidation markers by route/entity"
    }

    elastic = container "Elasticsearch" "Elasticsearch 8" "Search index and retrieval context for AI" {
      es_alerts = component "Alerts Index" "Search corpus for alerts"
      es_cases = component "Cases Index" "Search corpus for case entities"
      es_observables = component "Observables Index" "Search corpus for observables and indicators"
      es_forum = component "Forum Index" "Search corpus for discussion threads"
    }

    s3 = container "S3 Storage" "MinIO/AWS S3" "Attachment and media object payloads" {
      s3_user_media = component "User Media Objects" "Avatar and cover assets"
      s3_case_artifacts = component "Case Artifact Objects" "Uploaded binary evidence and files"
      s3_presigned = component "Presigned URL Contract" "Upload/download capability exchange"
    }

    kafka = container "Kafka" "Kafka (KRaft)" "Connector transport and async operation queue" {
      kafka_async_ops = component "Async Ops Topic" "Queued alert/case create-delete operations"
      kafka_inbound = component "Inbound Connector Topics" "External stream source subscriptions"
      kafka_outbound = component "Outbound Connector Topics" "Connector delivery streams"
      kafka_notifications = component "Notifications Topic" "User notification delivery queue for telegram and other channels"
    }

    ai_model = container "AI Model Runtime" "Ollama + llama3.2:3b" "Model serving for AI assistant and case analysis" {
      ai_inference = component "Inference Endpoint" "Model prompt execution and token generation"
      ai_model_registry = component "Model Registry" "Loaded model metadata and lifecycle"
    }

    otel = container "OTel Collector" "OpenTelemetry Collector" "Trace ingestion/export pipeline" {
      otel_traces = component "Trace Pipeline" "Receives and forwards application traces"
      otel_exporters = component "Exporter Pipeline" "Exports telemetry to backends"
    }

    prometheus = container "Prometheus" "Prometheus" "Metrics scraping and query storage" {
      prom_scrape = component "Scrape Jobs" "Polling backend metrics endpoint"
      prom_tsdb = component "TSDB" "Time-series storage for metrics"
    }

    grafana = container "Grafana" "Grafana" "Dashboards and operational visualizations" {
      grafana_dashboards = component "Operational Dashboards" "SOC and platform SLO views"
      grafana_alerting = component "Alert Rules" "Threshold and anomaly notifications"
    }
  }

  platform_admin -> incidenthub.frontend.admin_ui "Platform and tenant governance workflows"
  platform_admin -> incidenthub.frontend.dashboard_ui "Cross-tenant system visibility"
  tenant_admin -> incidenthub.frontend.admin_ui "Tenant-level administration and connector configuration"
  tenant_admin -> incidenthub.frontend.catalog_ui "Statuses, templates and automation policies"
  soc_analyst -> incidenthub.frontend.alerts_ui "Alert triage and prioritization"
  soc_analyst -> incidenthub.frontend.cases_ui "Case lifecycle and ownership actions"
  soc_analyst -> incidenthub.frontend.case_workspace_ui "Deep investigation activities"
  soc_analyst -> incidenthub.frontend.comms_ui "External participant communication in incidents"
  soc_analyst -> incidenthub.frontend.ai_ui "AI-assisted analysis and decision support"
  soc_analyst -> incidenthub.frontend.workflow_studio_ui "Design/run analyzer and responder workflows"
  incident_commander -> incidenthub.frontend.dashboard_ui "Incident posture and trend oversight"
  incident_commander -> incidenthub.frontend.case_workspace_ui "Major incident coordination"
  viewer -> incidenthub.frontend.dashboard_ui "Read-only dashboards"
  viewer -> incidenthub.frontend.cases_ui "Read-only case details"
  automation_bot -> incidenthub.backend.router "Automated API usage via API tokens"

  platform_admin -> incidenthub.frontend_runtime_packages.fe_src_pages "Platform and cross-tenant administration screens"
  tenant_admin -> incidenthub.frontend_runtime_packages.fe_src_pages "Tenant administration and configuration screens"
  soc_analyst -> incidenthub.frontend_runtime_packages.fe_src_pages "Operational workbench and investigation screens"
  incident_commander -> incidenthub.frontend_runtime_packages.fe_src_pages "Incident overview and coordination screens"
  viewer -> incidenthub.frontend_runtime_packages.fe_src_pages "Read-only dashboards and case views"
  automation_bot -> incidenthub.backend_runtime_packages.be_internal_api "Automated API calls with issued access tokens"

  incidenthub.frontend_runtime_packages.fe_src_pages -> incidenthub.frontend_runtime_packages.fe_src_components "Composes page layouts and reusable UI primitives"
  incidenthub.frontend_runtime_packages.fe_src_pages -> incidenthub.frontend_runtime_packages.fe_src_lib_api "Loads and mutates backend data"
  incidenthub.frontend_runtime_packages.fe_src_pages -> incidenthub.frontend_runtime_packages.fe_src_lib_shared "Uses shared state, routing, i18n and utilities"
  incidenthub.frontend_runtime_packages.fe_src_pages -> incidenthub.frontend_runtime_packages.fe_src_hooks "Uses page-level hooks and local interaction state"
  incidenthub.frontend_runtime_packages.fe_src_components -> incidenthub.frontend_runtime_packages.fe_src_lib_shared "Uses shared UI helpers, theme and runtime utilities"
  incidenthub.frontend_runtime_packages.fe_features_workflow_studio -> incidenthub.frontend_runtime_packages.fe_src_components "Builds workflow canvas and editor UI"
  incidenthub.frontend_runtime_packages.fe_features_workflow_studio -> incidenthub.frontend_runtime_packages.fe_src_lib_api "Persists workflow definitions and run state"
  incidenthub.frontend_runtime_packages.fe_features_workflow_studio -> incidenthub.frontend_runtime_packages.fe_src_lib_shared "Uses shared state, routing and utilities"
  incidenthub.frontend_runtime_packages.fe_features_connectors -> incidenthub.frontend_runtime_packages.fe_src_components "Builds connector management interactions"
  incidenthub.frontend_runtime_packages.fe_features_connectors -> incidenthub.frontend_runtime_packages.fe_src_lib_api "Reads and mutates connector configuration"
  incidenthub.frontend_runtime_packages.fe_features_connectors -> incidenthub.frontend_runtime_packages.fe_src_lib_shared "Uses shared runtime helpers and stores"
  incidenthub.frontend_runtime_packages.fe_src_hooks -> incidenthub.frontend_runtime_packages.fe_src_lib_shared "Composes shared runtime state and utility logic"
  incidenthub.frontend_runtime_packages.fe_src_lib_api -> incidenthub.backend_runtime_packages.be_internal_api "REST API calls over bearer auth and tenant context"

  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_config "Loads runtime configuration"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_database "Creates DB pools and migration lifecycle"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_bootstrap "Runs startup bootstrap flows"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_api "Registers HTTP server and handlers"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_auth "Builds JWT and LDAP auth services"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_repository "Wires repositories"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_cache "Connects Redis-backed cache and limits"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_connectors_inbound "Starts ingestion workers"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_connectors_outbound "Starts outbound transport services"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_forumproxy "Wires forum proxy"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_workflow "Wires workflow runtime"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_ai "Wires AI services"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_search "Configures search integration"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_storage "Configures artifact storage"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_metrics "Registers metrics exporter"
  incidenthub.backend_runtime_packages.be_cmd_api -> incidenthub.backend_runtime_packages.be_internal_tracing "Initializes trace pipeline"

  incidenthub.backend_runtime_packages.be_internal_database -> incidenthub.postgres "Initializes pools and applies migrations"
