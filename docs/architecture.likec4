  incidenthub.prometheus.prom_scrape -> incidenthub.prometheus.prom_tsdb "Persist scrape samples"
  incidenthub.grafana -> incidenthub.prometheus "Read metrics and render dashboards"
  incidenthub.grafana.grafana_dashboards -> incidenthub.prometheus.prom_tsdb "Render SOC/platform views from TSDB"
  incidenthub.grafana.grafana_alerting -> incidenthub.prometheus.prom_tsdb "Evaluate metric alert conditions"
}

