  incidenthub.backend.api_token_repo -> incidenthub.postgres "api_access_tokens"
  incidenthub.backend.api_token_repo -> incidenthub.postgres.pg_auth "api_access_tokens operations"
  incidenthub.backend.alert_repo -> incidenthub.postgres "alerts"
  incidenthub.backend.alert_repo -> incidenthub.postgres.pg_incidents "alerts table operations"
  incidenthub.backend.case_repo -> incidenthub.postgres "cases"
  incidenthub.backend.case_repo -> incidenthub.postgres.pg_incidents "cases table operations"
  incidenthub.backend.task_repo -> incidenthub.postgres "tasks"
