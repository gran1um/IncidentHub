    include incidenthub.s3
    include incidenthub.kafka
    include external_data_sources
    include external_comm_channels
    autoLayout LeftRight
  }

  view observabilityPipelines {
    title "Observability Pipelines (Metrics + Traces)"
    include platform_admin
    include incidenthub.backend
    include incidenthub.backend.request_metrics
    include incidenthub.backend.system_api
    include incidenthub.otel
    include incidenthub.otel.*
    include incidenthub.prometheus
    include incidenthub.prometheus.*
    include incidenthub.grafana
    include incidenthub.grafana.*
    include incidenthub.postgres
    include incidenthub.redis
    include incidenthub.elastic
    include incidenthub.s3
    include incidenthub.ai_model
    autoLayout TopBottom
  }
}
