# Global

# Public domains (required if you enable the Caddy edge proxy)
# APP_DOMAIN=incidenthub.example.com
# S3_DOMAIN=s3.incidenthub.example.com
# CADDY_EMAIL=admin@incidenthub.example.com
APP_DOMAIN=
S3_DOMAIN=
CADDY_EMAIL=

ENV=dev
COMPOSE_PROJECT_NAME=incidenthub

# Backend
HTTP_ADDR=:8080
HTTP_WRITE_TIMEOUT=60s
HTTP_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
HTTP_SECURE_COOKIES=false
HTTP_EXPOSE_SWAGGER=true

AUTH_JWT_SECRET=change-me-please-very-long-random-secret
AUTH_ISSUER=incidenthub
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=24h
AUTH_REFRESH_COOKIE_NAME=ih_refresh_token

SEC_PASSWORD_MIN_LENGTH=12
SEC_LOGIN_RATE_LIMIT=10
SEC_LOGIN_RATE_WINDOW=5m
ARTIFACTS_MAX_UPLOAD_MB=50
ARTIFACTS_PRESIGN_TTL=15m

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=incidenthub
POSTGRES_PASSWORD=incidenthub
POSTGRES_DB=incidenthub
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2

REDIS_ADDR=redis:6379
REDIS_DB=0
API_CACHE_ENABLED=true
API_CACHE_TTL=30s
API_CACHE_MAX_BODY_BYTES=1048576

S3_ENABLED=true
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=incidenthub-artifacts
S3_ACCESS_KEY=incidenthub
S3_SECRET_KEY=incidenthub123
S3_USE_SSL=false
S3_AUTO_CREATE_BUCKET=true

ELASTIC_ENABLED=true
ELASTIC_ADDRESSES=http://elasticsearch:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=elastic
ELASTIC_INDEX_PREFIX=incidenthub

LDAP_ENABLED=false
LDAP_URL=ldap://ldap:389
LDAP_BASE_DN=dc=example,dc=org
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(uid=%s)

BOOTSTRAP_ENABLED=true
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@incidenthub.local
BOOTSTRAP_PLATFORM_ADMIN_USERNAME=platform-admin
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=ChangeMeNow123!
BOOTSTRAP_PLATFORM_ADMIN_FULL_NAME=Platform Administrator

LOGGER_GROUP=soc_dev
LOGGER_SYSTEM=incidenthub
LOG_LEVEL=info
TRACE_ENABLED=true
TRACE_TENANT=soc-ir
TRACE_SERVICE_KEY=incidenthub
METRICS_NAMESPACE=incidenthub

CONNECTORS_INBOUND_ENABLED=true
CONNECTORS_INBOUND_POLL_INTERVAL=5m
CONNECTORS_INBOUND_HTTP_TIMEOUT=20s
CONNECTORS_INBOUND_BATCH_LIMIT=200
CONNECTORS_OUTBOUND_HTTP_TIMEOUT=15s
CONNECTORS_OUTBOUND_TELEGRAM_API_BASE_URL=https://api.telegram.org

ASYNC_OPS_ENABLED=false
ASYNC_OPS_KAFKA_BROKERS=kafka:9092
ASYNC_OPS_KAFKA_TOPIC=incidenthub.async.ops
ASYNC_OPS_KAFKA_DLQ_TOPIC=incidenthub.async.ops.dlq
ASYNC_OPS_KAFKA_GROUP_ID=incidenthub-api-async-ops
ASYNC_OPS_PRODUCE_TIMEOUT=5s
ASYNC_OPS_POLL_TIMEOUT=1s
ASYNC_OPS_RETRY_MAX_ATTEMPTS=5
ASYNC_OPS_RETRY_BASE_BACKOFF=500ms
ASYNC_OPS_RETRY_MAX_BACKOFF=15s

NOTIFICATIONS_KAFKA_ENABLED=true
NOTIFICATIONS_KAFKA_BROKERS=kafka:9092
NOTIFICATIONS_KAFKA_TOPIC=incidenthub.notifications
NOTIFICATIONS_KAFKA_DLQ_TOPIC=incidenthub.notifications.dlq
NOTIFICATIONS_KAFKA_GROUP_ID=incidenthub-api-notifications
NOTIFICATIONS_PRODUCE_TIMEOUT=5s
NOTIFICATIONS_POLL_TIMEOUT=1s
NOTIFICATIONS_RETRY_MAX_ATTEMPTS=5
NOTIFICATIONS_RETRY_BASE_BACKOFF=500ms
NOTIFICATIONS_RETRY_MAX_BACKOFF=15s

WORKFLOW_ENGINE=internal

AI_ENABLED=true
AI_PROVIDER=openai-compatible
AI_ENDPOINT=http://host:8001/v1/chat/completions
AI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=http://host:8001/v1
AI_MODEL=Qwen/Qwen3-14B-AWQ
AI_TIMEOUT=60s
AI_TOP_K=6
AI_MAX_CONTEXT_CHARS=5000
AI_HISTORY_MESSAGES=20
AI_MCP_ENABLED=true
AI_MCP_TOOLS_ALLOWLIST=open_case_statuses,cases_in_work,recent_cases,recent_alerts,dashboard_stats
AI_MCP_PER_TOOL_LIMIT=5
AI_SYSTEM_PROMPT=You are a SOC assistant specialized in information security incident response. Provide concise, actionable analysis grounded in the provided tenant data.
AI_MAX_CONCURRENT_SESSIONS=2
AI_AGENT_QUEUE_ENABLED=true
AI_AGENT_QUEUE_POLL_INTERVAL=3s
AI_AGENT_QUEUE_BATCH_SIZE=20
AI_AGENT_QUEUE_RUN_TIMEOUT=90s
AI_AGENT_QUEUE_MAX_RETRIES=3

# Frontend
VITE_API_URL=
VITE_SUPPORT_URL=https://support.example.com
VITE_UI_SKELETON_MIN_MS=300
TEST_DATA_LAB_PORT=5190
VITE_TEST_DATA_LAB_DEFAULT_API_BASE_URL=
VITE_TEST_DATA_LAB_DEFAULT_TENANT_ID=
VITE_TEST_DATA_LAB_DEFAULT_LANGUAGE=ru

# Infra
POSTGRES_IMAGE=postgres:18
ELASTIC_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.13.4
ELASTIC_PLATFORM=linux/amd64
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Tests (must point to isolated DB, never production/dev DB)
TEST_DATABASE_URL=postgres://incidenthub:incidenthub@localhost:5432/incidenthub_test?sslmode=disable
