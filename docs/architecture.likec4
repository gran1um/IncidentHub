  incidenthub.backend.media_service -> incidenthub.backend.attachment_repo "Attachment metadata updates"
  incidenthub.backend.media_service -> incidenthub.backend.user_repo "Profile media URL updates"

  incidenthub.backend.migration_runner -> incidenthub.postgres "schema_migrations and SQL migration application"
  incidenthub.backend.migration_runner -> incidenthub.postgres.pg_migrations "Migration version lock/checkpoint writes"
  incidenthub.backend.bootstrap_seed -> incidenthub.postgres "Platform bootstrap and initial seed entities"
  incidenthub.backend.bootstrap_seed -> incidenthub.postgres.pg_auth "Bootstrap admin user/session structures"
  incidenthub.backend.bootstrap_seed -> incidenthub.postgres.pg_tenant "Bootstrap tenant/membership structures"

  incidenthub.backend.user_repo -> incidenthub.postgres "users, user profile fields, media URL refs"
