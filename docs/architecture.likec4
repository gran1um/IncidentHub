  incidenthub.backend.notification_bot_repo -> incidenthub.postgres "telegram_notification_bots create/update/delete/list operations"
  incidenthub.backend.notification_bot_repo -> incidenthub.postgres.pg_notifications "tenant bot identity and config operations"
  incidenthub.backend.notification_settings_repo -> incidenthub.postgres "user_notification_settings get/upsert/delete operations"
  incidenthub.backend.notification_settings_repo -> incidenthub.postgres.pg_notifications "tenant-user notification delivery preference operations"
  incidenthub.backend.forum_binding_repo -> incidenthub.postgres "forum_external_bindings, connector_recipient_aliases"
  incidenthub.backend.forum_binding_repo -> incidenthub.postgres.pg_connectors "forum binding and alias operations"
