FROM node:22-alpine AS builder
RUN corepack enable
WORKDIR /app

COPY test-data-lab/package.json ./package.json
RUN pnpm install --no-frozen-lockfile

COPY test-data-lab ./

ARG VITE_TEST_DATA_LAB_DEFAULT_API_BASE_URL
ARG VITE_TEST_DATA_LAB_DEFAULT_TENANT_ID
ARG VITE_TEST_DATA_LAB_DEFAULT_LOGIN_EMAIL
ARG VITE_TEST_DATA_LAB_DEFAULT_LOGIN_PASSWORD
ARG VITE_TEST_DATA_LAB_DEFAULT_LANGUAGE

ENV VITE_TEST_DATA_LAB_DEFAULT_API_BASE_URL=${VITE_TEST_DATA_LAB_DEFAULT_API_BASE_URL}
ENV VITE_TEST_DATA_LAB_DEFAULT_TENANT_ID=${VITE_TEST_DATA_LAB_DEFAULT_TENANT_ID}
ENV VITE_TEST_DATA_LAB_DEFAULT_LOGIN_EMAIL=${VITE_TEST_DATA_LAB_DEFAULT_LOGIN_EMAIL}
ENV VITE_TEST_DATA_LAB_DEFAULT_LOGIN_PASSWORD=${VITE_TEST_DATA_LAB_DEFAULT_LOGIN_PASSWORD}
ENV VITE_TEST_DATA_LAB_DEFAULT_LANGUAGE=${VITE_TEST_DATA_LAB_DEFAULT_LANGUAGE}

RUN pnpm build

FROM nginx:1.27-alpine
COPY deploy/nginx/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
ENTRYPOINT ["nginx", "-g", "daemon off;"]
